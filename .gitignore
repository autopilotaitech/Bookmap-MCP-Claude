*.iml
*.class
.DS_Store

# Python (mcp-server/)
__pycache__/
*.pyc
.venv/
.pytest_cache/
*.egg-info/

# Bridge runtime artifacts — never commit the shared secret.
bridge.properties

# Stray build outputs that Bookmap might pick up as duplicate add-ons
*.backup-*.jar
*FIXED.jar
out/

# Local rollback snapshots — large, regenerated by phase backups during refactors
_phase_backups/

# Superpowers / skill scratch dirs (workspace-local brainstorming, not source)
.superpowers/

# Nested worktree of the upstream trendanalyzer-mvp addon. Its calc classes
# are PORTED into src/main/java/com/bookmapmcp/trend/ — the upstream addon
# itself must NOT be vendored or submoduled into this repo.
indicators/trendanalyzer-mvp/

# Runtime auto-saved settings checkpoint (hot-reloaded by dashboard; not config)
mcp-server/bookmap_mcp/pax_settings.last_good.json

# Stray pytest cache that lands beside the .pytest_cache dir on some platforms
pytest-cache-files-*/

# OS
Thumbs.db

# IDE
.vscode/
*.swp

# Claude Code per-user permission grants (machine-local)
.claude/settings.local.json

